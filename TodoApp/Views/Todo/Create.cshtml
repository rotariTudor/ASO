@model TodoItem
@{
    ViewData["Title"] = "Adaugă Task Nou";
}

<div class="form-page">
    <div class="form-header">
        <a href="/Todo" class="back-link">← Înapoi</a>
        <h1>Adaugă Task Nou</h1>
        <p>Completează detaliile task-ului tău.</p>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Title" class="form-label">Titlu <span class="required">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="Ce trebuie să faci?" autofocus />
                <span asp-validation-for="Title" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Descriere (opțional)</label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Adaugă detalii suplimentare..."></textarea>
                <span asp-validation-for="Description" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Priority" class="form-label">Prioritate</label>
                <div class="priority-selector">
                    <label class="prio-option">
                        <input type="radio" asp-for="Priority" value="2" />
                        <span class="prio-chip high">🔴 Urgent</span>
                    </label>
                    <label class="prio-option">
                        <input type="radio" asp-for="Priority" value="1" checked />
                        <span class="prio-chip medium">🟡 Mediu</span>
                    </label>
                    <label class="prio-option">
                        <input type="radio" asp-for="Priority" value="0" />
                        <span class="prio-chip low">🟢 Mic</span>
                    </label>
                </div>
            </div>

            <div class="form-actions">
                <a href="/Todo" class="btn btn-secondary">Anulează</a>
                <button type="submit" class="btn btn-primary">✓ Adaugă Task</button>
            </div>
        </form>
    </div>
</div>
