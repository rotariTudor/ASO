@model TodoItem
@{
    ViewData["Title"] = "Editează Task";
}

<div class="form-page">
    <div class="form-header">
        <a href="/Todo" class="back-link">← Înapoi</a>
        <h1>Editează Task</h1>
        <p>Modifică detaliile task-ului.</p>
    </div>

    <div class="form-card">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Title" class="form-label">Titlu <span class="required">*</span></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Descriere (opțional)</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Priority" class="form-label">Prioritate</label>
                <div class="priority-selector">
                    <label class="prio-option">
                        <input type="radio" asp-for="Priority" value="2" />
                        <span class="prio-chip high">🔴 Urgent</span>
                    </label>
                    <label class="prio-option">
                        <input type="radio" asp-for="Priority" value="1" />
                        <span class="prio-chip medium">🟡 Mediu</span>
                    </label>
                    <label class="prio-option">
                        <input type="radio" asp-for="Priority" value="0" />
                        <span class="prio-chip low">🟢 Mic</span>
                    </label>
                </div>
            </div>

            <div class="meta-info">
                <small>Creat: @Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")</small>
                @if (Model.IsCompleted && Model.CompletedAt.HasValue)
                {
                    <small>Finalizat: @Model.CompletedAt.Value.ToString("dd MMMM yyyy, HH:mm")</small>
                }
            </div>

            <div class="form-actions">
                <a href="/Todo" class="btn btn-secondary">Anulează</a>
                <button type="submit" class="btn btn-primary">💾 Salvează</button>
            </div>
        </form>
    </div>
</div>
