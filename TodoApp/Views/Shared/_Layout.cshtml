<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TodoApp</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a href="/Todo" class="logo">
                <span class="logo-icon">✓</span>
                <span class="logo-text">TodoApp</span>
            </a>
            <nav>
                <a href="/Todo" class="nav-link">Lista mea</a>
                <a href="/Todo/Create" class="nav-link btn-primary">+ Adaugă</a>
            </nav>
        </div>
    </header>

    <main class="site-main">
        <div class="container">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <span>✓</span> @TempData["Success"]
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>TodoApp · Proiect ASP.NET Core cu Entity Framework &amp; SQLite</p>
        </div>
    </footer>

    <script src="~/js/site.js"></script>
</body>
</html>
